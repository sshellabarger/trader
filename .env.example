# Alpaca credentials for the trader bot.
# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is gitignored and is NEVER copied into the Docker image.

# --- PAPER (default, no real money) ---
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- GO LIVE (real money) ---
# Switching to live trading changes ONLY these three values: your LIVE keys and
# the live base URL. Nothing else in the app changes. Validate on paper first.
# APCA_API_KEY_ID=your_live_key_id
# APCA_API_SECRET_KEY=your_live_secret
# APCA_API_BASE_URL=https://api.alpaca.markets

# Optional: market-data feed. 'iex' (default) is free but partial; 'sip' is the
# full consolidated tape and needs a paid Alpaca data plan.
# APCA_DATA_FEED=iex

# --- Strategy experiment toggles (code defaults are off) ---
# Overnight-alignment ENTRY filter: skip ORB longs on days the index gapped
# DOWN overnight. Backtest 2025-01..2026-06 on IEX: +4.2% vs -9.3% baseline,
# drawdown 8.6% vs 17.2%. Enabled for the paper test:
ORB_REQUIRE_OVERNIGHT_ALIGNMENT=true
# Minimum overnight gap % to allow an ORB long (default 0.0 = non-negative):
# ORB_OVERNIGHT_GAP_MIN_PCT=0.0
# Overnight HOLD (carry ORB winners past the close) — backtest-only, keep off:
# ORB_HOLD_OVERNIGHT=false
