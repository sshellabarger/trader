# Alpaca credentials for the trader bot.
# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is gitignored and is NEVER copied into the Docker image.

# --- PAPER (default, no real money) ---
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- GO LIVE (real money) ---
# Switching to live trading changes ONLY these three values: your LIVE keys and
# the live base URL. Nothing else in the app changes. Validate on paper first.
# APCA_API_KEY_ID=your_live_key_id
# APCA_API_SECRET_KEY=your_live_secret
# APCA_API_BASE_URL=https://api.alpaca.markets

# Optional: market-data feed. 'iex' (default) is free but partial; 'sip' is the
# full consolidated tape (Alpaca "Algo Trader Plus", ~$99/month). On the free
# IEX feed the stock sleeve only gets reliable intraday bars for LIQUID names —
# thin / low-priced names return no bars and never trade, so on IEX keep the
# sleeve on STOCK_SLEEVE_UNIVERSE=liquid_movers. Switch to sip to trade the
# wider, more volatile pool.
# APCA_DATA_FEED=iex

# --- Strategy experiment toggles (code defaults are off) ---
# Overnight-alignment ENTRY filter: skip ORB longs on days the index gapped
# DOWN overnight. Backtest 2025-01..2026-06 on IEX: +4.2% vs -9.3% baseline,
# drawdown 8.6% vs 17.2%. Enabled for the paper test:
ORB_REQUIRE_OVERNIGHT_ALIGNMENT=true
# Minimum overnight gap % to allow an ORB long (default 0.0 = non-negative):
# ORB_OVERNIGHT_GAP_MIN_PCT=0.0
# Overnight HOLD (carry ORB winners past the close) — backtest-only, keep off:
# ORB_HOLD_OVERNIGHT=false

# ORB entry-gate knobs (2026-07-22). These are the two most binding gates and
# were previously hardcoded. Defaults unchanged; tune ONLY to values the sleeve
# replay backtester (python -m trader sleeve-backtest --sweep) validated on a
# train/test split — loosening them by feel is how the -10%/yr era happened.
# ORB_MIN_RANGE_PCT=0.5            # opening-range floor, % of price
# ORB_MAX_RANGE_PCT=1.2            # ceiling; 0 = uncapped
# ORB_ENTRY_WINDOW_MINUTES=3       # entry window after the range completes
# ATR-scaled band (replaces the fixed % band when the symbol's daily ATR% is
# available; sized per symbol instead of TQQQ-calibrated). Live wiring for
# daily_atr_pct lands with the tuned deploy; harmless to leave off until then.
# ORB_RANGE_BAND_ATR=false
# ORB_RANGE_ATR_LO=0.15            # band floor = LO x daily ATR%
# ORB_RANGE_ATR_HI=0.45            # band ceiling = HI x daily ATR%

# --- Stock sleeve (stocks-only, scanner-driven) — OFF by default ---
# When enabled the bot STOPS trading the TQQQ/SQQQ index legs and instead
# day-trades a basket of individual HIGH-GROWTH STOCKS chosen each morning by
# the scanner (premarket gappers/movers), using the same long-only ORB breakout
# with bracket stops and an end-of-day flatten. Paper account only; validate a
# few sessions before trusting it.
#
# Turn it on:
# STOCK_SLEEVE_ENABLED=true
#
# Which names to scan — either named universe categories (default liquid_movers,
# curated to have reliable IEX intraday bars). Only use the wider, thinner
# tech_volatile,volatile_movers pool on the paid SIP feed (see APCA_DATA_FEED).
# STOCK_SLEEVE_UNIVERSE=liquid_movers
# ... or an explicit watchlist, which OVERRIDES the categories when set:
# STOCK_SLEEVE_SYMBOLS=NVDA,PLTR,SMCI,ARM,CRWD,MSTR
# ... or a screened pool file refreshed weekly by `screen-universe` (liquidity +
# volatility), which takes priority over the categories:
# STOCK_SLEEVE_POOL_FILE=data/pool.json
#
# News / catalysts (default off): each morning add the top news-catalyst names
# (most fresh coverage) to the scan pool, AND skip breakout longs into strongly
# negative headlines. Uses the free Alpaca news feed with your existing keys.
# STOCK_SLEEVE_NEWS_ENABLED=true
# STOCK_SLEEVE_NEWS_HOTLIST=10           # catalyst names added to the pool
# STOCK_SLEEVE_NEWS_LOOKBACK_MIN=1080    # how far back to scan news (~18h)
# STOCK_SLEEVE_NEWS_BLOCK_BELOW=-0.4     # block a long when mean sentiment <= this
#
# How aggressive (sane paper defaults shown):
# STOCK_SLEEVE_MAX_CANDIDATES=5     # top-N scanner picks to trade each day
# STOCK_SLEEVE_MAX_POSITIONS=3      # most names held at once (concurrency cap)
# STOCK_SLEEVE_MAX_POSITION_PCT=25  # per-name cap, % of equity
#
# Long-bias the picks (default ON): the sleeve trades LONG breakouts only, so
# gap-DOWN movers waste a slot — rank gap-ups first and trade only non-negative
# gaps (fewer names on a red morning). Set false for the old direction-agnostic
# picks. Skipped gap-downs land in the daily summary as gap_down_long_only.
# STOCK_SLEEVE_LONG_BIAS=true
#
# Optional hard risk caps — apply in BOTH modes, override the code defaults:
# RISK_PER_TRADE_PCT=3
# MAX_RISK_DOLLARS=3000
# MAX_DAILY_TRADES=10
# DAILY_LOSS_LIMIT_PCT=6
#
# The overnight-alignment gate above is an INDEX feature and is inert for
# stocks, so ORB_REQUIRE_OVERNIGHT_ALIGNMENT can be left as-is.

# --- Backtest honesty knobs (no effect on live trading) ---
# Decision-grade backtests should be run with BOTH of these. Same-bar-close
# fills and 2bps slippage flatter every result: the live bot polls on a 30s
# loop and sends MARKET orders, so the earliest realistic entry is the NEXT
# bar's open, and stops fill through gaps. If the edge disappears under these
# settings, it never existed.
# BACKTEST_ENTRY_FILL_NEXT_OPEN=true
# BACKTEST_SLIPPAGE_BPS=10

# --- Kalshi phase-0 recorder (trader/kalshi/; runs as the kalshi-recorder
# --- compose service). Market data is PUBLIC: the recorder needs NO
# --- credentials. Everything below is optional tuning.
#
# Series to record (comma-separated). Defaults are verified live as of
# 2026-07-28; browse current tickers with `python -m trader kalshi-discover`.
# KALSHI_SERIES=KXHIGHCHI,KXHIGHNY,KXHIGHDEN,KXHIGHAUS,KXCPI,KXMLBGAME,KXNFLGAME
#
# Cadence: base polling, and a faster rate for any series with a market
# closing within the hot window (sports pre-game, econ release mornings).
# KALSHI_BASE_INTERVAL_SEC=60
# KALSHI_HOT_INTERVAL_SEC=10
# KALSHI_HOT_WINDOW_HOURS=2
#
# Order-book depth snapshots (one request per market, so budgeted): only for
# markets closing within the window, capped per cycle, soonest-close first.
# KALSHI_BOOK_WINDOW_HOURS=2
# KALSHI_BOOK_MAX_PER_CYCLE=20
# KALSHI_BOOK_DEPTH=5
#
# Output + request budget (Kalshi basic tier allows ~10 req/s; stay under).
# KALSHI_DATA_DIR=data/kalshi
# KALSHI_REQUESTS_PER_SECOND=5
#
# --- Kalshi trading auth: NOT needed in phase 0. Only for the demo-exchange
# --- order test and later phases. Generate an RSA keypair, upload the public
# --- key in the Kalshi dashboard, keep the private key PEM out of the repo.
# --- Point the base URL at the demo exchange while testing order code:
# KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
